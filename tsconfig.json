{
  "compilerOptions": {
    "rootDir": "./src",
    "target": "ES2022",
    "module": "node16",
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "declaration": true,
    "removeComments": true,
    "allowJs": true,
    "outDir": "./lib",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node16",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
